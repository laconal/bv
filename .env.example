ENVIRONMENT=development
DJANGO_SECRET_KEY=django-insecure-i2QoLtgm3vR4gIEMzoWje1EytrIhX0EsCKmzfboPkShRb7pGGf
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

DB_NAME=birid
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5450

JWT_ALGORITHM=RS256

STORE_ADMIN_PRIVATE_KEY_PATH=secrets/store_admin_private_key.pem
STORE_ADMIN_PUBLIC_KEY_PATH=secrets/store_admin_public_key.pem
STORE_ADMIN_ACCESS_TOKEN_EXPIRE_SECONDS=86400
STORE_ADMIN_REFRESH_TOKEN_EXPIRE_SECONDS=604800

BUYER_PRIVATE_KEY_PATH=secrets/buyer_private_key.pem
BUYER_PUBLIC_KEY_PATH=secrets/buyer_public_key.pem
BUYER_ACCESS_TOKEN_EXPIRE_SECONDS=1800
BUYER_REFRESH_TOKEN_EXPIRE_SECONDS=2592000

MINIO_ACCESS_KEY=miniotest
MINIO_SECRET_KEY=miniotest
MINIO_BUCKET_NAME=birid-product-photos
MINIO_ENDPOINT_URL=http://localhost:9000
# Public host for file URLs returned to clients (domain + bucket name),
# reverse-proxied to the minio container. Leave unset for bare local dev.
# MINIO_PUBLIC_URL=files.yourdomain.com/birid-product-photos

CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2
